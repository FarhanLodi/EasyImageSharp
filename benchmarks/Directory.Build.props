<Project>

  <!--
    MSBuild stops at the nearest Directory.Build.props, so without this import everything under
    benchmarks/ would silently lose the repository-wide settings (LangVersion, Nullable, Deterministic,
    Company/Product/Copyright and TreatWarningsAsErrors).
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    BenchmarkDotNet compiles one auto-generated project per benchmark run and builds it with the ordinary
    MSBuild rules, so it inherits this file. Program.cs pins BenchmarkDotNet's ArtifactsPath under
    benchmarks/, which guarantees the generated project lands inside this file's scope. That generated code
    is not ours and does not satisfy our analysis settings, so warnings-as-errors would abort every run
    before a single benchmark executed. Exempt only the generated project; hand-written benchmark code
    keeps warnings-as-errors.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('BenchmarkDotNet.Autogenerated'))">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0162;CS8618;CS8625;CS1591;CS0649</NoWarn>
  </PropertyGroup>

</Project>
