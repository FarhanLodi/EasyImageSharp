# libFuzzer/AFL dictionary for TIFF 6.0 and BigTIFF. Tags are given in both byte orders, together with a few
# complete IFD entry prefixes (tag, type, count) so the fuzzer can splice whole fields.

le_header="II*\x00"
be_header="MM\x00*"
le_bigtiff="II+\x00\x08\x00\x00\x00"
be_bigtiff="MM\x00+\x00\x08\x00\x00"
le_first_ifd="II*\x00\x08\x00\x00\x00"
be_first_ifd="MM\x00*\x00\x00\x00\x08"

# Baseline and extension tags, little-endian
le_NewSubfileType="\xfe\x00"
le_ImageWidth="\x00\x01"
le_ImageLength="\x01\x01"
le_BitsPerSample="\x02\x01"
le_Compression="\x03\x01"
le_Photometric="\x06\x01"
le_FillOrder="\x0a\x01"
le_StripOffsets="\x11\x01"
le_Orientation="\x12\x01"
le_SamplesPerPixel="\x15\x01"
le_RowsPerStrip="\x16\x01"
le_StripByteCounts="\x17\x01"
le_XResolution="\x1a\x01"
le_YResolution="\x1b\x01"
le_PlanarConfig="\x1c\x01"
le_T4Options="\x24\x01"
le_T6Options="\x25\x01"
le_ResolutionUnit="\x28\x01"
le_Predictor="\x3d\x01"
le_ColorMap="\x40\x01"
le_TileWidth="\x42\x01"
le_TileLength="\x43\x01"
le_TileOffsets="\x44\x01"
le_TileByteCounts="\x45\x01"
le_SubIFDs="\x4a\x01"
le_InkSet="\x4c\x01"
le_ExtraSamples="\x52\x01"
le_SampleFormat="\x53\x01"
le_JPEGTables="\x5b\x01"
le_JPEGIFOffset="\x01\x02"
le_JPEGIFByteCount="\x02\x02"
le_YCbCrCoefficients="\x11\x02"
le_YCbCrSubSampling="\x12\x02"
le_YCbCrPositioning="\x13\x02"
le_ReferenceBlackWhite="\x14\x02"
le_XMP="\xbc\x02"
le_IPTC="\xbb\x83"
le_Photoshop="\x49\x86"
le_ExifIFD="\x69\x87"
le_ICC="\x73\x87"

# The same tags, big-endian
be_NewSubfileType="\x00\xfe"
be_ImageWidth="\x01\x00"
be_ImageLength="\x01\x01"
be_BitsPerSample="\x01\x02"
be_Compression="\x01\x03"
be_Photometric="\x01\x06"
be_FillOrder="\x01\x0a"
be_StripOffsets="\x01\x11"
be_Orientation="\x01\x12"
be_SamplesPerPixel="\x01\x15"
be_RowsPerStrip="\x01\x16"
be_StripByteCounts="\x01\x17"
be_PlanarConfig="\x01\x1c"
be_Predictor="\x01\x3d"
be_ColorMap="\x01\x40"
be_TileWidth="\x01\x42"
be_TileLength="\x01\x43"
be_TileOffsets="\x01\x44"
be_TileByteCounts="\x01\x45"
be_ExtraSamples="\x01\x52"
be_SampleFormat="\x01\x53"
be_JPEGTables="\x01\x5b"
be_YCbCrSubSampling="\x02\x12"
be_ICC="\x87\x73"

# Entry prefixes: ImageWidth SHORT x1, ImageLength LONG x1, StripOffsets LONG x1 (little-endian), ImageWidth (big-endian)
le_entry_width_short="\x00\x01\x03\x00\x01\x00\x00\x00"
le_entry_length_long="\x01\x01\x04\x00\x01\x00\x00\x00"
le_entry_strip_long="\x11\x01\x04\x00\x01\x00\x00\x00"
be_entry_width_short="\x01\x00\x00\x03\x00\x00\x00\x01"

# Field types, little-endian
le_type_byte="\x01\x00"
le_type_ascii="\x02\x00"
le_type_short="\x03\x00"
le_type_long="\x04\x00"
le_type_rational="\x05\x00"
le_type_undefined="\x07\x00"
le_type_float="\x0b\x00"
le_type_double="\x0c\x00"
le_type_ifd="\x0d\x00"
le_type_long8="\x10\x00"
le_type_ifd8="\x12\x00"

# Compression values, little-endian: none, CCITT RLE, T.4, T.6, LZW, old JPEG, JPEG, Adobe Deflate, PackBits, Deflate
le_comp_none="\x01\x00"
le_comp_ccitt_rle="\x02\x00"
le_comp_t4="\x03\x00"
le_comp_t6="\x04\x00"
le_comp_lzw="\x05\x00"
le_comp_ojpeg="\x06\x00"
le_comp_jpeg="\x07\x00"
le_comp_deflate="\x08\x00"
le_comp_packbits="\x05\x80"
le_comp_deflate_old="\xb2\x80"

# LZW: a strip that opens with the clear code, and one that is clear followed by end-of-information
lzw_clear="\x80"
lzw_clear_eoi="\x80\x00\x80\x80"
