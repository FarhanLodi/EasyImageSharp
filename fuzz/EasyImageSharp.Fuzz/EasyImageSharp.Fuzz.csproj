<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Coverage-guided fuzzing harness (SharpFuzz + libFuzzer). Not a member of EasyImageSharp.slnx, for the same
    reason samples/ and benchmarks/ are not: it is single-target net10.0 and a tool rather than a shipped
    assembly, and SharpFuzz/dnlib have no business in the packaging graph. It is built and run by path; see
    fuzz/README.md and .github/workflows/fuzz-libfuzzer.yml.

    The harness itself is never instrumented. After `dotnet publish`, the fuzz scripts run the `sharpfuzz`
    tool over the published EasyImageSharp.dll only, which rewrites it in place with coverage probes.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>EasyImageSharp.Fuzz</AssemblyName>
    <RootNamespace>EasyImageSharp.Fuzz</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!--
      The OSS-Fuzz runner image has no ICU, and nothing here formats culture-sensitive text, so invariant
      globalization keeps a self-contained publish runnable there without extra native libraries.
    -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      Workstation, non-concurrent GC: one fuzz input runs at a time, and a background GC thread only adds
      scheduling noise to the per-input allocation measurement in FuzzContract.
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Coverage feedback only makes sense when the same input takes the same path; keep PGO out of the way. -->
    <TieredPGO>false</TieredPGO>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- For TraceMap only: SharpFuzz exposes its coverage map as a byte* field. Nothing else here is unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- SharpFuzz (MIT, https://github.com/Metalnem/sharpfuzz): the libFuzzer IPC bridge and trace map. -->
    <PackageReference Include="SharpFuzz" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EasyImageSharp\EasyImageSharp.csproj" />
  </ItemGroup>

</Project>
