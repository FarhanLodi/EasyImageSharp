<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compatibility package. Its types moved into EasyImageSharp.Codecs in 1.3.1 (same namespace, same API); this
    assembly only forwards them there, so existing references keep compiling and binaries built against 1.2.0 keep
    running. New code should reference EasyImageSharp.Codecs directly.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>EasyImageSharp.LittleCms</PackageId>
    <Version>1.3.1</Version>
    <Authors>Farhan Lodi</Authors>
    <Description>Moved to EasyImageSharp.Codecs. This package now only forwards the EasyImageSharp.LittleCms types (ICC transforms through Little CMS) to EasyImageSharp.Codecs, which it depends on, so existing code and binaries keep working. Reference EasyImageSharp.Codecs directly in new code.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/FarhanLodi/EasyImageSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/FarhanLodi/EasyImageSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>image;icc;littlecms;cmyk;color-management</PackageTags>
    <PackageReleaseNotes>1.3.1: the implementation moved to EasyImageSharp.Codecs; this package forwards to it.</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <!-- Validated against the published 1.2.0 package: the forwarded types must still present the same API. -->
  <PropertyGroup Label="Package validation">
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.2.0</PackageValidationBaselineVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../EasyImageSharp.Codecs/EasyImageSharp.Codecs.csproj" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../EasyImageSharp/Assets/icon.png" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>
</Project>
