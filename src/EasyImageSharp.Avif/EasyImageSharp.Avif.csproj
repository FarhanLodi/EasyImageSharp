<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>EasyImageSharp.Avif</PackageId>
    <Version>1.3.0</Version>
    <Authors>Farhan Lodi</Authors>
    <Description>Optional native AVIF decoder and encoder for EasyImageSharp, powered by libavif 1.x: 8/10/12-bit still images and image sequences, alpha, ICC/EXIF/XMP, quality/speed/chroma-subsampling control and resource limits enforced before pixel allocation.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/FarhanLodi/EasyImageSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/FarhanLodi/EasyImageSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>image;imaging;avif;av1;libavif;decode;encode;hdr;animation</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <NativeAvifPath>$(MSBuildThisFileDirectory)../../.artifacts/native/libavif/win-x64/avif.dll</NativeAvifPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../EasyImageSharp/EasyImageSharp.csproj" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="THIRD_PARTY_NOTICES.txt" Pack="true" PackagePath="" />
    <None Include="../EasyImageSharp/Assets/icon.png" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(NativeAvifPath)" Condition="Exists('$(NativeAvifPath)')" Pack="true" PackagePath="runtimes/win-x64/native/avif.dll" Link="avif.dll" CopyToOutputDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="EasyImageSharp.Avif.Tests" />
  </ItemGroup>
  <ItemGroup Label="Public API tracking">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="PublicAPI/$(TargetFramework)/PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI/$(TargetFramework)/PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <Target Name="RequireNativeAvifForPack" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(NativeAvifPath)')" Text="Build the reproducible win-x64 libavif runtime with scripts/build-libavif.ps1 before packing." />
  </Target>
</Project>
