<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>EasyImageSharp.JpegXl</PackageId>
    <Version>1.3.0</Version>
    <Authors>Farhan Lodi</Authors>
    <Description>Optional native JPEG XL decoder and encoder for EasyImageSharp, powered by libjxl: 8/16-bit and float images, animation, alpha, ICC/EXIF/XMP boxes, lossless and lossy (distance/effort) encoding, with resource limits enforced before pixel allocation.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/FarhanLodi/EasyImageSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/FarhanLodi/EasyImageSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>image;imaging;jpegxl;jxl;libjxl;decode;encode;lossless;hdr;animation</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <NativeJxlDirectory>$(MSBuildThisFileDirectory)../../.artifacts/native/libjxl/win-x64/</NativeJxlDirectory>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../EasyImageSharp/EasyImageSharp.csproj" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="THIRD_PARTY_NOTICES.txt" Pack="true" PackagePath="" />
    <None Include="../EasyImageSharp/Assets/icon.png" Pack="true" PackagePath="" Visible="false" />
    <!-- The official upstream win-x64 runtime: libjxl plus its brotli and cms companions (scripts/build-libjxl.ps1). -->
    <NativeJxlRuntime Include="jxl.dll;jxl_cms.dll;jxl_threads.dll;brotlicommon.dll;brotlidec.dll;brotlienc.dll" />
    <None Include="@(NativeJxlRuntime->'$(NativeJxlDirectory)%(Identity)')" Condition="Exists('$(NativeJxlDirectory)jxl.dll')" Pack="true" PackagePath="runtimes/win-x64/native/" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="EasyImageSharp.JpegXl.Tests" />
  </ItemGroup>
  <ItemGroup Label="Public API tracking">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="PublicAPI/$(TargetFramework)/PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI/$(TargetFramework)/PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <Target Name="RequireNativeJxlForPack" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(NativeJxlDirectory)jxl.dll')" Text="Fetch the pinned win-x64 libjxl runtime with scripts/build-libjxl.ps1 before packing." />
  </Target>
</Project>
