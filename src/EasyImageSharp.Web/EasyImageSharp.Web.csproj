<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EasyImageSharp.Web</RootNamespace>
    <AssemblyName>EasyImageSharp.Web</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <!--
      EasyImageSharpWebOptions binds from IConfiguration through the configuration binding source generator, so
      the IConfiguration overload of AddEasyImageSharpWeb stays trim and Native AOT clean. Logging goes through the
      LoggerMessage source generator; both generators ship in the ASP.NET Core targeting pack.
    -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>EasyImageSharp.Web</PackageId>
    <Version>1.3.1</Version>
    <Authors>Farhan Lodi</Authors>
    <Title>EasyImageSharp.Web</Title>
    <Description>ASP.NET Core image middleware for EasyImageSharp: app.UseEasyImageSharp() resizes, crops, pads, re-orients and transcodes images on the fly from query commands (width, height, mode, anchor, format, quality, bgcolor, autoorient, sampler, rotate, flip), with HMAC-SHA256 signed URLs (key rotation, optional expiry), Accept-header WebP negotiation with Vary: Accept, ETag / Last-Modified / 304 handling, HEAD support, path-traversal-safe file sources, physical-disk and IDistributedCache output caches with atomic writes, output limits, a concurrency limiter that answers 503 when saturated, cancellation on client abort and a health check. Also includes the dependency-injection integration (services.AddEasyImageSharp(): decoder limits, pixel-buffer budget and parallelism from code or IConfiguration, validated on start, with ready-made DecoderOptions and ImageExecutionOptions), usable without the middleware. Fully managed; depends only on the ASP.NET Core shared framework.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/FarhanLodi/EasyImageSharp</PackageProjectUrl>
    <PackageTags>image;imaging;aspnetcore;middleware;dependency-injection;options;configuration;resize;thumbnail;webp;cdn;image-server;signed-url;hmac;cache;managed;aot</PackageTags>
    <PackageReleaseNotes>1.3.1: first release. On-the-fly processing middleware, signed URLs, format negotiation, HTTP and server-side caching, limits, concurrency limiting, a health check, and the AddEasyImageSharp dependency-injection integration. See CHANGELOG.md.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/FarhanLodi/EasyImageSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../EasyImageSharp/Assets/icon.png" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <!--
    Everything this package needs beyond EasyImageSharp itself (hosting, options, logging, file providers,
    IDistributedCache, health checks, System.Threading.RateLimiting) is part of the ASP.NET Core shared framework,
    so there is no NuGet package reference at all.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../EasyImageSharp/EasyImageSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EasyImageSharp.Web.Tests" />
  </ItemGroup>

  <ItemGroup Label="Public API tracking">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="PublicAPI/$(TargetFramework)/PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI/$(TargetFramework)/PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
