<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>EasyImageSharp.Codecs</PackageId>
    <Version>1.3.1</Version>
    <Authors>Farhan Lodi</Authors>
    <Description>Optional native codecs and colour management for EasyImageSharp in one package: AVIF (libavif 1.x with libaom: 8/10/12-bit stills and sequences), JPEG XL (libjxl: 8/16-bit and float, animation, lossless and lossy) and LittleCMS ICC v2/v4 transforms (RGB, CMYK, Gray, Lab, XYZ, LUT profiles, rendering intents, black-point compensation). Resource limits are enforced before pixel allocation. Windows x64 runtimes are bundled; Linux and macOS use the system libraries.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/FarhanLodi/EasyImageSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/FarhanLodi/EasyImageSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>image;imaging;avif;av1;jpegxl;jxl;icc;littlecms;cmyk;color-management;decode;encode;hdr;animation</PackageTags>
    <PackageReleaseNotes>1.3.1: first release, combining AVIF and JPEG XL support with the LittleCMS transforms previously shipped as EasyImageSharp.LittleCms (same namespaces and API). See CHANGELOG.md.</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <NativeAvifPath>$(MSBuildThisFileDirectory)../../.artifacts/native/libavif/win-x64/avif.dll</NativeAvifPath>
    <NativeJxlDirectory>$(MSBuildThisFileDirectory)../../.artifacts/native/libjxl/win-x64/</NativeJxlDirectory>
    <NativeLcmsPath>$(MSBuildThisFileDirectory)../../.artifacts/native/lcms2/win-x64/lcms2.dll</NativeLcmsPath>
  </PropertyGroup>
  <!--
    Package validation runs on every `dotnet pack`. There is no published release to compare against yet;
    set PackageValidationBaselineVersion to 1.3.1 once it is on nuget.org so later releases are checked
    for binary compatibility with it.
  -->
  <PropertyGroup Label="Package validation">
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../EasyImageSharp/EasyImageSharp.csproj" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="THIRD_PARTY_NOTICES.txt" Pack="true" PackagePath="" />
    <None Include="../EasyImageSharp/Assets/icon.png" Pack="true" PackagePath="" Visible="false" />

    <!-- libavif + libaom, built reproducibly from pinned sources (scripts/build-libavif.ps1). -->
    <None Include="$(NativeAvifPath)" Condition="Exists('$(NativeAvifPath)')" Pack="true" PackagePath="runtimes/win-x64/native/avif.dll" Link="avif.dll" CopyToOutputDirectory="PreserveNewest" />
    <!-- The official upstream win-x64 libjxl release plus its brotli and cms companions (scripts/build-libjxl.ps1). -->
    <NativeJxlRuntime Include="jxl.dll;jxl_cms.dll;jxl_threads.dll;brotlicommon.dll;brotlidec.dll;brotlienc.dll" />
    <None Include="@(NativeJxlRuntime->'$(NativeJxlDirectory)%(Identity)')" Condition="Exists('$(NativeJxlDirectory)jxl.dll')" Pack="true" PackagePath="runtimes/win-x64/native/" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- LittleCMS (scripts/build-littlecms.ps1). -->
    <None Include="$(NativeLcmsPath)" Condition="Exists('$(NativeLcmsPath)')" Pack="true" PackagePath="runtimes/win-x64/native/lcms2.dll" Link="lcms2.dll" CopyToOutputDirectory="PreserveNewest" />

    <InternalsVisibleTo Include="EasyImageSharp.Avif.Tests" />
    <InternalsVisibleTo Include="EasyImageSharp.JpegXl.Tests" />
    <InternalsVisibleTo Include="EasyImageSharp.LittleCms.Tests" />
  </ItemGroup>
  <ItemGroup Label="Public API tracking">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="PublicAPI/$(TargetFramework)/PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI/$(TargetFramework)/PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <Target Name="RequireNativeRuntimesForPack" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(NativeAvifPath)')" Text="Build the reproducible win-x64 libavif runtime with scripts/build-libavif.ps1 before packing." />
    <Error Condition="!Exists('$(NativeJxlDirectory)jxl.dll')" Text="Fetch the pinned win-x64 libjxl runtime with scripts/build-libjxl.ps1 before packing." />
    <Error Condition="!Exists('$(NativeLcmsPath)')" Text="Build the reproducible win-x64 LittleCMS runtime with scripts/build-littlecms.ps1 before packing." />
  </Target>
</Project>
