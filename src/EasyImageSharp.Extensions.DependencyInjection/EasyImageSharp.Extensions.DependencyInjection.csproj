<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>EasyImageSharp.Extensions.DependencyInjection</RootNamespace>
    <AssemblyName>EasyImageSharp.Extensions.DependencyInjection</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <!--
      Configuration binding goes through the configuration binding source generator, so binding
      EasyImageSharpOptions from IConfiguration needs no reflection and stays trim/AOT clean.
    -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>EasyImageSharp.Extensions.DependencyInjection</PackageId>
    <Version>1.3.0</Version>
    <Authors>Farhan Lodi</Authors>
    <Title>EasyImageSharp.Extensions.DependencyInjection</Title>
    <Description>Microsoft.Extensions.DependencyInjection integration for EasyImageSharp: services.AddEasyImageSharp() binds decoder limits (MaxPixels, MaxTotalPixels, MaxFrames, MaxEncodedBytes), the pixel-buffer budget and parallelism from code or IConfiguration with the AOT-friendly configuration binding source generator, validates them on start, and resolves ready-made DecoderOptions and ImageExecutionOptions from the container.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/FarhanLodi/EasyImageSharp</PackageProjectUrl>
    <PackageTags>image;imaging;dependency-injection;options;configuration;hosting;aspnetcore;managed;aot</PackageTags>
    <PackageReleaseNotes>1.3.0: first release. AddEasyImageSharp with code and IConfiguration overloads, ValidateOnStart validation and IImageOptionsFactory. See CHANGELOG.md.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/FarhanLodi/EasyImageSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../EasyImageSharp/Assets/icon.png" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <!--
    Microsoft.Extensions.* (MIT). Each target framework references the release line that ships with it, so an
    ASP.NET Core 8 application keeps resolving these assemblies from its own shared framework.
    Configuration.Binder is referenced directly because it carries the binding source generator.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../EasyImageSharp/EasyImageSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EasyImageSharp.Extensions.DependencyInjection.Tests" />
  </ItemGroup>

  <ItemGroup Label="Public API tracking">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
    <AdditionalFiles Include="PublicAPI/$(TargetFramework)/PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI/$(TargetFramework)/PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
