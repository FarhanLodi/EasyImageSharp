<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>EasyImageSharp</RootNamespace>
    <AssemblyName>EasyImageSharp</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>EasyImageSharp</PackageId>
    <Version>1.2.0</Version>
    <Authors>Farhan Lodi</Authors>
    <Title>EasyImageSharp</Title>
    <Description>A fully managed imaging library for .NET: PNG, JPEG (incl. progressive and CMYK), WebP, GIF, BMP, TIFF, TGA, Netpbm, QOI and ICO codecs, an Image&lt;TPixel&gt; processing pipeline (resize, crop, rotate, blur/sharpen, thresholding incl. Otsu/Sauvola/Bradley, deskew) and image-to-tensor bridges for ONNX and other ML runtimes. AOT and trimming friendly.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/FarhanLodi/EasyImageSharp</PackageProjectUrl>
    <PackageTags>image;imaging;png;jpeg;jpg;webp;gif;bmp;tiff;tga;qoi;ico;exif;metadata;decode;encode;resize;crop;rotate;threshold;otsu;sauvola;deskew;ocr;tensor;onnx;managed;aot</PackageTags>
    <PackageReleaseNotes>1.2.0: reusable and fused OCR tensors; high-precision geometry; adaptive document diagnostics and coordinate maps; request-local execution policies, bounded input, incremental headers and lazy TIFF pages; RGB color conversions and matrix/TRC ICC support; opt-in format providers. See CHANGELOG.md for limits and validation.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/FarhanLodi/EasyImageSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="Assets/icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EasyImageSharp.Tests" />
    <InternalsVisibleTo Include="EasyImageSharp.AI" />
  </ItemGroup>

  <ItemGroup Label="Public API tracking">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="PublicAPI/$(TargetFramework)/PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI/$(TargetFramework)/PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
